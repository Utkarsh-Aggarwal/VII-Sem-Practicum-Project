# --- Database ---
DATABASE_URL="file:./dev.db"

# --- Auth ---
# Long random string used to sign caregiver sessions. Generate with: openssl rand -hex 32
AUTH_SECRET="change-me"

# --- AI companion (all optional: without a key the companion uses its built-in offline replies) ---
# LLM_PROVIDER: "groq" | "gemini" | "openai-compatible". Defaults to whichever key is set.
LLM_PROVIDER=""
GROQ_API_KEY=""
GROQ_MODEL="openai/gpt-oss-120b"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"
# Any OpenAI-compatible /chat/completions endpoint (Ollama, OpenRouter, ...)
LLM_BASE_URL=""
LLM_API_KEY=""
LLM_MODEL=""

# ElevenLabs voice (recommended for Hindi): speech-to-text (Scribe) + natural text-to-speech for the
# senior app's hold-to-talk and the hub. Without it, STT falls back to Groq Whisper and replies are
# spoken by the phone's built-in voice.
ELEVENLABS_API_KEY=""
ELEVENLABS_VOICE_ID=""            # optional: pick a voice from elevenlabs.io/app/voice-library
ELEVENLABS_TTS_MODEL="eleven_multilingual_v2"
ELEVENLABS_STT_MODEL="scribe_v2"

# Speech-to-text for hub voice clips (OpenAI-compatible /audio/transcriptions). Defaults to Groq Whisper if GROQ_API_KEY is set.
STT_BASE_URL=""
STT_API_KEY=""
STT_MODEL="whisper-large-v3-turbo"
# Text-to-speech for the hub speaker (OpenAI-compatible /audio/speech). Leave empty to let the hub/app speak text itself.
TTS_BASE_URL=""
TTS_API_KEY=""
TTS_MODEL=""
TTS_VOICE=""

# --- Smart home hub transport (optional) ---
# When set, the backend connects to this broker and bridges carecircle/v1/hub/{deviceId}/... topics.
# The ESP32-CAM's existing home/door/status topic is never touched.
MQTT_URL=""
MQTT_USERNAME=""
MQTT_PASSWORD=""
# Hardware emergency alerts: every message on this topic becomes a critical caregiver alert (text or JSON, never filtered).
MQTT_ALERT_TOPIC="project/phase3sem7/alert"
# Which parent those alerts belong to (id or name, comma-separated). Default: parents with a camera set.
MQTT_ALERT_ELDER_ID=""

# Optional mmWave bathroom sensor (firmware/esp32-mmwave). Ignored until a sensor publishes here.
# Its messages go to the parent in the payload's elderId, else MQTT_ALERT_ELDER_ID, else parents with a camera.
MQTT_MMWAVE_TOPIC="project/phase3sem7/mmwave"

# --- Camera AI (services/vision: YOLO pose + DeepFace) ---
# Shared secret the vision service sends as "Authorization: Bearer ...". Empty = camera AI off.
VISION_TOKEN=""
# Address of the camera AI service as browsers and phones reach it (e.g. "http://192.168.1.10:8100").
# Set it when the service runs: the live feed then plays the service's relayed copy of the ESP32-CAM
# stream, because the camera serves only one viewer and the service must be that viewer.
VISION_STREAM_URL=""

# --- Scheduler tuning (minutes / hours) ---
REMIND_AGAIN_AFTER_MIN=15
MISSED_AFTER_MIN=60
NO_ACTIVITY_ALERT_HOURS=4
SCHEDULER_DISABLED=""
